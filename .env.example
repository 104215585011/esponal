# YouTube search tuning. Empty values keep the built-in defaults.
# regionCode biases results to a country (e.g. ES / MX / US); the Data API
# defaults to US when this is unset, which is one reason results differ from
# what you see signed in on youtube.com.
YOUTUBE_REGION_CODE=""
# Freshness window for shared YouTube search cache. Default 86400 (24h).
# Lowering it makes results newer but burns search.list quota faster
# (100 units per cold query, ~100 distinct queries/day on the default quota).
YOUTUBE_SEARCH_CACHE_TTL_SECONDS=""
# Maximum age of a cached result served as a fallback when YouTube fails.
# Default 86400 (24h). Beyond this, the API reports an error instead of
# silently showing week-old results.
YOUTUBE_STALE_MAX_AGE_SECONDS=""
