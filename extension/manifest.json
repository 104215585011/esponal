{
  "manifest_version": 3,
  "name": "LinguaMind",
  "description": "LinguaMind YouTube learning companion.",
  "version": "0.1.0",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
    "default_popup": "popup.html",
    "default_title": "LinguaMind"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["dist/content.js", "dist/harvest.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*", "https://*.vercel.app/*"],
      "js": ["dist/esponal-site.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/embed/*"],
      "js": ["dist/content.js", "dist/harvest.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*", "https://www.youtube.com/embed/*"],
      "js": ["dist/hook-timedtext.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/hook-timedtext.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://www.youtube.com/*"
  ],
  "permissions": ["activeTab", "scripting", "storage", "webNavigation"]
}
